\\ UNIT 06: CONGRUENCES AND QUADRATIC RESIDUES

kronecker(2,7)       \\ Kronecker symbol
issquare(49)         \\ Check perfect square
sqrtint(50)          \\ Integer square root
rootsmod(x^2-1,15)   \\ Polynomial roots modulo 15
polrootsmod(x^2-1,7) \\ Polynomial roots modulo 7
znorder(Mod(2,7))    \\ Multiplicative order
znlog(Mod(4,7),Mod(2,7)) \\ Discrete logarithm

Q = Qfb(1,0,-1);     \\ Construct binary quadratic form
qfbred(Q)            \\ Reduce quadratic form

