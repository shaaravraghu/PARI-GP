\\ UNIT 03: BASIC MATHEMATICAL FUNCTIONS

abs(-12)       \\ Absolute value
sign(-12)      \\ Sign of a number
sqrt(144)      \\ Square root
floor(3.8)     \\ Round down
ceil(3.2)      \\ Round up
round(3.7)     \\ Round to nearest integer
frac(3.75)     \\ Fractional part

exp(1)         \\ Exponential e^x
log(10)        \\ Natural logarithm
log(8, 2)      \\ Logarithm base 2

sin(Pi/6)      \\ Sine
cos(Pi/3)      \\ Cosine
tan(Pi/4)      \\ Tangent
asin(1)        \\ Inverse sine
acos(0)        \\ Inverse cosine
atan(1)        \\ Inverse tangent

sinh(1)        \\ Hyperbolic sine
cosh(1)        \\ Hyperbolic cosine
tanh(1)        \\ Hyperbolic tangent

gamma(5)       \\ Gamma function
zeta(2)        \\ Riemann zeta function
psi(1)         \\ Digamma function
