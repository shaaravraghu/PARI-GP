\\ UNIT 04: INTEGER AND NUMBER THEORY

gcd(48,18)        \\ Greatest common divisor
gcdext(48,18)     \\ Extended Euclidean algorithm
lcm(12,18)        \\ Least common multiple
valuation(360,2)  \\ Exponent of prime 2 in 360
core(72)          \\ Square-free kernel
issquare(144)     \\ Test perfect square
ispower(64)       \\ Test perfect power
sqrtint(200)      \\ Integer square root

\\ Prime numbers
isprime(97)       \\ Test primality
ispseudoprime(341) \\ Test pseudoprimality
prime(10)         \\ Find 10th prime
primes([1,30])    \\ List primes in interval
nextprime(100)    \\ Next prime after 100
precprime(100)    \\ Previous prime before 100
factor(360)       \\ Prime factorisation
primepi(100)      \\ Count primes <= 100
znprimroot(7)     \\ Primitive root modulo 7

\\ Arithmetic functions
eulerphi(12)      \\ Euler's totient function
moebius(30)       \\ Möbius function
numdiv(36)        \\ Number of divisors
sumdiv(36)        \\ Sum of divisors
divisors(36)      \\ List all divisors
sigma(36)         \\ Divisor sum function
bigomega(360)     \\ Prime factors counted with multiplicity
omega(360)        \\ Distinct prime factors

