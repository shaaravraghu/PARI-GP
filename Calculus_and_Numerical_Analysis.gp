\\ UNIT 10: CALCULUS AND NUMERICAL ANALYSIS

f(x) = x^3 + 2*x^2 + 5*x;

deriv(f)                \\ Derivative
taylor(exp(x),x,0,8)    \\ Taylor expansion
intnum(x=0,1,x^2)       \\ Numerical integration
sum(i=1,10,i^2)         \\ Summation
prod(i=1,5,i)           \\ Product
solve(x=0,3,x^2-2)      \\ Numerical equation solving
polroots(x^2-2)         \\ Polynomial roots
polrootsreal(x^2-2)     \\ Real polynomial roots

